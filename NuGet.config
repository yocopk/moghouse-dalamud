<?xml version="1.0" encoding="utf-8"?>
<!--
  Pinned so the build does not depend on whatever sources the machine happens to have configured.
  Dalamud.NET.Sdk is an MSBuild project SDK resolved from NuGet, so a missing source fails the
  build before compilation even starts.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
